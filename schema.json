{
  "database": "CognitaAI",
  "version": "vFinal-2025",
  "description": "Full 62-table relational schema for Cognita AI meeting, transcript, billing, analytics and multilingual platform.",
  "tables": [
    {
      "id": 1,
      "name": "orgs",
      "description": "Organizations that own users, workspaces and billing accounts.",
      "fields": [
        { "name": "org_id", "type": "UUID", "pk": true },
        { "name": "name", "type": "TEXT" },
        { "name": "billing_account_id", "type": "UUID" },
        { "name": "created_at", "type": "TIMESTAMP" },
        { "name": "retention_policy", "type": "JSON" },
        { "name": "settings", "type": "JSON" }
      ]
    },
    {
      "id": 2,
      "name": "users",
      "description": "Platform end users; may belong to orgs or standalone workspaces.",
      "fields": [
        { "name": "user_id", "type": "UUID", "pk": true },
        { "name": "org_id", "type": "UUID" },
        { "name": "role_id", "type": "UUID" },
        { "name": "email", "type": "TEXT" },
        { "name": "display_name", "type": "TEXT" },
        { "name": "metadata", "type": "JSON" },
        { "name": "preferences", "type": "JSON" },
        { "name": "created_at", "type": "TIMESTAMP" }
      ]
    },
    {
      "id": 3,
      "name": "roles",
      "description": "Role definitions at org or workspace level; supports inheritance.",
      "fields": [
        { "name": "role_id", "type": "UUID", "pk": true },
        { "name": "name", "type": "TEXT" },
        { "name": "scope", "type": "TEXT" },
        { "name": "inherits_from", "type": "UUID" },
        { "name": "description", "type": "TEXT" },
        { "name": "created_at", "type": "TIMESTAMP" }
      ]
    },
    {
      "id": 4,
      "name": "permissions",
      "description": "Permission registry for RBAC model.",
      "fields": [
        { "name": "permission_id", "type": "SERIAL", "pk": true },
        { "name": "name", "type": "TEXT" },
        { "name": "description", "type": "TEXT" },
        { "name": "scope", "type": "TEXT" }
      ]
    },
    {
      "id": 5,
      "name": "role_permissions",
      "description": "Links permissions to roles.",
